#!/bin/bash
# shellcheck disable=SC2154  # Variables are supplied by dreport.

# Source OpenPOWER functions used by the packaging override.
# shellcheck source=dump/tools/common/include/opfunctions
. "$DREPORT_INCLUDE/opfunctions"

# Set by dreport before this extension is sourced.
declare -x name_dir

# @brief Package the dump, apply the IBM header and transfer it to the
#        requested location.
function package()
{
    local archive_file="${name_dir}.bin"
    local archive_path
    local include_pel_path=false
    local output_file
    local profile="bmc"
    local publish_dir
    local -a packager_args

    if ! mkdir -p "$dump_dir"; then
        log_error "Could not create the destination directory $dump_dir"
        return "$INTERNAL_FAILURE"
    fi
    if ! publish_dir=$(realpath "$dump_dir"); then
        log_error "Could not resolve the destination directory $dump_dir"
        return "$INTERNAL_FAILURE"
    fi

    echo "performing dump compression $name_dir"
    if [ "$dump_type" = "$TYPE_FAULTDATA" ]; then
        profile="fault"
        rm -f "$name_dir/dreport.log" "$name_dir/summary.log"
        if ! tar -cf "$archive_file" -C "$(dirname "$name_dir")" \
            "$(basename "$name_dir")"; then
            echo "$($TIME_STAMP)" "Could not create the archive"
            rm -f "$archive_file"
            return "$INTERNAL_FAILURE"
        fi
    else
        if ! (set -o pipefail
            tar cf - -C "$(dirname "$name_dir")" \
                "$(basename "$name_dir")" | zstd > "$archive_file"); then
            echo "$($TIME_STAMP)" "Could not create the compressed archive"
            rm -f "$archive_file"
            return "$INTERNAL_FAILURE"
        fi
    fi

    if ! archive_path=$(realpath "$archive_file"); then
        echo "$($TIME_STAMP)" "Could not resolve the dump archive path"
        return "$INTERNAL_FAILURE"
    fi
    output_file="$publish_dir/$(basename "$archive_file")"

    packager_args=(
        op-dump-packager
        --profile "$profile"
        --archive "$archive_path"
        --output "$output_file"
        --dump-id "$dump_id"
        --epoch "$EPOCHTIME"
    )
    if [ -n "${TYPE_ELOG:-}" ] && [ "$dump_type" = "$TYPE_ELOG" ]; then
        include_pel_path=true
    fi
    if [ -n "${TYPE_CHECKSTOP:-}" ] && [ "$dump_type" = "$TYPE_CHECKSTOP" ]; then
        include_pel_path=true
    fi
    if [ "$include_pel_path" = true ] && [ -n "${optional_path:-}" ]; then
        packager_args+=(--pel-path "$optional_path")
    fi

    echo "Adding validated fixed dump header"
    if ! "${packager_args[@]}"; then
        echo "$($TIME_STAMP)" "Could not package the dump"
        echo "Unheadered dump retained at $archive_path"
        return "$INTERNAL_FAILURE"
    fi

    # Publication is complete. Remove the temporary collection and source.
    rm -rf "$name_dir"
    if [ "$archive_path" != "$output_file" ]; then
        rm -f "$archive_path"
    fi

    echo "$($TIME_STAMP)" "Report is available in $dump_dir"
    return "$SUCCESS"
}
